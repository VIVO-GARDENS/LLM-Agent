# Copiar a .env y rellenar. El .env NUNCA se commitea (ver .gitignore).

# --- Anthropic --------------------------------------------------------------
# Prepago desde $5. Ojo: la suscripción de Claude NO da crédito de API.
ANTHROPIC_API_KEY=

# Opcionales: valores por defecto en agente/agente.py
MODELO_AGENTE=claude-sonnet-5
MAX_TOKENS=8000
# low | medium | high | xhigh | max — triage de DMs no necesita más que low
ESFUERZO=low

# --- Instagram / Meta (Fase 3, todavía no se usa) ---------------------------
# Token de la app de Meta con instagram_business_manage_messages
IG_ACCESS_TOKEN=
# Cadena que se elige libremente y debe coincidir con la del panel de Meta
IG_VERIFY_TOKEN=
IG_ACCOUNT_ID=

# --- Aviso al equipo (Fase 3) ----------------------------------------------
# WhatsApp Cloud API. Si la aprobación de plantillas se atasca, la alternativa
# es Telegram (ver el plan): TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
EQUIPO_WHATSAPP=

# --- Estado (Fase 3) --------------------------------------------------------
DATABASE_URL=

# --- Servicio HTTP (lo llama n8n) -------------------------------------------
# Secreto compartido con n8n. Si queda vacio, /responder queda ABIERTO:
# cualquiera que sepa la URL puede gastar tus creditos de API.
SERVICIO_TOKEN=

# --- n8n (docker compose en n8n/) -------------------------------------------
# Cifra las credenciales que guardes dentro de n8n. Si la pierdes, esas
# credenciales quedan ilegibles. Generar con: python -c "import secrets;print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=
# Postgres lee POSTGRES_*; n8n espera DB_POSTGRESDB_*. Son los MISMOS valores
# con otros nombres, y hacen falta los dos juegos: el compose los inyecta por
# env_file y nadie los traduce.
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_PASSWORD=
